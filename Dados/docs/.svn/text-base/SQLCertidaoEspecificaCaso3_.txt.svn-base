 SELECT 
    P.SQ_PESSOA,P.NO_PESSOA,PF.SQ_PESSOA
 FROM 
    VINCULO V LEFT JOIN PESSOA_FISICA PF ON V.SQ_PESSOA_VINCULADA = PF.SQ_PESSOA LEFT JOIN PESSOA P ON 
    V.SQ_PESSOA_VINCULANTE = P.SQ_PESSOA LEFT JOIN PESSOA_JURIDICA PJ ON V.SQ_PESSOA_VINCULANTE = PJ.SQ_PESSOA 
    LEFT JOIN SITUACAO S ON PJ.CO_SITUACAO = S.CO_SITUACAO LEFT JOIN FISICA_INDIVIDUAL FI ON V.SQ_PESSOA_VINCULADA = FI.SQ_PESSOA
 WHERE  
     PF.NR_CPF = '15031957102' AND V.CO_CONDICAO = '801'
     
 SELECT * FROM PESSOA WHERE SQ_PESSOA = 606719 
 SELECT * FROM PESSOA_FISICA WHERE SQ_PESSOA =  606719 
 
 SELECT * FROM PESSOA_FISICA PF 
 WHERE PF.NR_CPF = '11355182468';
 
 SELECT * FROM PESSOA WHERE SQ_PESSOA = 502207
 SELECT * FROM FISICA_INDIVIDUAL WHERE SQ_PESSOA = 502207
 SELECT * FROM VINCULO V WHERE V.SQ_PESSOA_VINCULADA = 502207 AND CO_CONDICAO = '801'

 SELECT 
    PF.NR_CPF CPF,P.NO_PESSOA EMPRESARIO,FI.NO_MAE MAE,FI.NO_PAI PAI,V.CO_CONDICAO,PEMP.NO_PESSOA EMPRESA, PJ.NR_NIRE,PJ.CO_SITUACAO
 FROM 
    PESSOA_FISICA PF LEFT JOIN PESSOA P ON PF.SQ_PESSOA = P.SQ_PESSOA LEFT JOIN
    FISICA_INDIVIDUAL FI ON FI.SQ_PESSOA = P.SQ_PESSOA LEFT JOIN VINCULO V ON
    V.SQ_PESSOA_VINCULADA = P.SQ_PESSOA LEFT JOIN PESSOA_JURIDICA PJ ON 
    V.SQ_PESSOA_VINCULANTE = PJ.SQ_PESSOA LEFT JOIN PESSOA PEMP ON V.SQ_PESSOA_VINCULANTE = PEMP.SQ_PESSOA
 WHERE
    PF.NR_CPF = '11355182468'    
            


 SELECT 
    PF.NR_CPF,P.NO_PESSOA,V.CO_CONDICAO, S.DS_SITUACAO
 FROM 
    VINCULO V LEFT JOIN PESSOA_FISICA PF ON V.SQ_PESSOA_VINCULADA = PF.SQ_PESSOA LEFT JOIN PESSOA P ON 
    V.SQ_PESSOA_VINCULANTE = P.SQ_PESSOA LEFT JOIN PESSOA_JURIDICA PJ ON V.SQ_PESSOA_VINCULANTE = PJ.SQ_PESSOA 
    LEFT JOIN SITUACAO S ON PJ.CO_SITUACAO = S.CO_SITUACAO
 WHERE  
    ROWNUM <=10 AND NR_CPF IS NOT NULL AND S.CO_SITUACAO IN ('04') AND V.CO_CONDICAO = '801'


     ('00','02','03','13','04','06','07','08','09','10','11','12','14','15','16','17','18')

