	'Envia um email com o formulário de abertura de conta para o gerente
	'ou com o feedback da solicitação. Valores para tipo:
	'0 = Conta não autorizada
	'1 = Conta autorizada
	'2 = Envia o PDF com o formulário
	'3 = Envia o login e a senha para o novo usuário
	function enviaMailPdf(cod,tipo)
		Dim Template
		Dim BD

		Dim modelo, titulo

		Set BD = new TBD
		call BD.conecta
		call BD.insereCampoQuery ("COD_USUARIOGED", cod)
		call BD.abreQuery("FORMULARIOUSUARIO",1)

		select case cint(tipo)
			case 0
				modelo = "mailRecusaCadastro.htm"
				titulo = "Recusa de Cadastro no Sistema de Imagens - GED JUCEPE"
			case 1
				modelo = "mailAutorizaCadastro.htm"
				titulo = "Autorização de Cadastro no Sistema de Imagens - GED JUCEPE"
			case 2
				modelo = "mailConfCadastro.htm"
				titulo = "Solicitação de Cadastro no Sistema de Imagens - GED JUCEPE"
			case 3
				modelo = "mailSenhaCadastro.htm"
				titulo = "Seu Cadastro no Sistema de Imagens - GED JUCEPE"
		end select


		Set Template = new TTemplate

		'Prepara o modelo de email
		call Template.create( _
			modelo, _
			"GED - Jucepe", _
			mailGED, _
			mailBCC, _
			0, _
			titulo)

		'Insere as tags que podem ser substituídas no texto
		for i = 0 to BD.numCampos-1
			s = BD.valor(BD.NomeCampo(i))
			if left (BD.nomeCampo(i),3) = "CPF" then s = fnFormataCPF(s)
			if left (BD.nomeCampo(i),3) = "CEP" then s = left(s,5) & "-" & right(s,3)
			if ucase(BD.NomeCampo(i)) = "SENHA" then s = encodePWD (s, 0)
			call Template.insereTag (BD.NomeCampo(i), s)
		next

		'Insere uma tag adicional: com o endereço montado
		s = BD.valor("logradouro")
		if BD.valor ("numero") & "" <> "" then s = s & ", " & BD.valor("numero")
		if BD.valor ("complemento") & "" <> "" then s = s & " / " & BD.valor("Complemento")
		call Template.insereTag ("ENDERECO", s)

		'Insere as tags dos emails de feedback
		call Template.insereTag ("OBS",request.form("obs"))
		call Template.insereTag ("MOTIVO",request.form("motivo"))

		'Insere o PDF com anexo
		if tipo = 2 then call template.insereAttach (Server.MapPath("temp\" & geraPDFUsuario(cod)))

		'Insere o destinatário:
		if tipo <> 3 then
			'O responsável pelo cadastro
			call Template.insereDest (BD.valor("NOME_RESP"), BD.valor("EMAIL_RESP"), "", "")
		else
			'O usuário cadastrado
			call Template.insereDest (BD.valor("NOME"), BD.valor("EMAIL"), "", "")
		end if

		'Envia o e-mail
		call Template.enviaEmail (1, 1)

		set Template = nothing

		call BD.desconecta
		set BD = nothing
	end function


	'Loga atividades do usuário
	'tipo: (L)ogin, (I)magem, (N)ire, (A)utenticidade
	'info:		L - Cod_usuarioged,Status
	'			I - Seqüencial da imagem
	'			N - NIRE da empresa
	'			A - Controle, Email
	function logaAtividade (tipo, info)
		dim BD
		dim primLogin
		dim primConsImg
		dim primConsNire
		dim primConsAut

		Set BD = new TBD
		call BD.conecta

		'Verifica se há algum login
		call BD.abreQuery ("LOGNUMLOGINS",1)
		primLogin = (cint(BD.valor("QUANT")) = 0)
		call BD.fechaQuery
		call BD.limpaCamposQuery

		'Verifica se há alguma consulta a imagem
		call BD.abreQuery ("LOGNUMCONSIMG",1)
		primConsImg = (cint(BD.valor("QUANT")) = 0)
		call BD.fechaQuery
		call BD.limpaCamposQuery

		'Verifica se há alguma consulta a NIRE
		call BD.abreQuery ("LOGNUMCONSNIRE",1)
		primConsNire = (cint(BD.valor("QUANT")) = 0)
		call BD.fechaQuery
		call BD.limpaCamposQuery

		'Verifica se há alguma consulta de autenticidade
		call BD.abreQuery ("LOGNUMCONSAUT",1)
		primConsAut = (cint(BD.valor("QUANT")) = 0)
		call BD.fechaQuery
		call BD.limpaCamposQuery

		'Prepara os campos genéricos
		call BD.insereCampoQuery("SEQUENCIALLOG",session ("login").item("SQ_LOGINUSUARIOGED"))
		call BD.insereCampoQuery("COD_USUARIOGED",session("login").item("COD_USUARIOGED"))
		call BD.insereCampoQuery("EMAIL",session("login").item("EMAIL"))
		call BD.insereCampoQuery("DATAHORA","to_date(`" & fnFormataData(date,2) & " " & fnFormataHora(time,2) & "`,`DD/MM/YYYY HH24:MI`)")
		call BD.insereCampoQuery("IP",session ("remote_addr"))
		call BD.insereCampoQuery("STATUS",info)


		select case tipo

			case "L"
				if primLogin then
					'Não há logins. Crie o primeiro
					call BD.insereCampoQuery ("SEQ","1")
				else
					'Já há logins. Crie o próximo
					call BD.insereCampoQuery ("SEQ","(SELECT MAX(SQ_LOGINUSUARIOGED) FROM LOGINUSUARIOGED)+1")
				end if

				'Insere o log
				call BD.abreQuery ("LOGLOGIN",0)

				'Obtém o seqüencial do LOG
				call BD.limpaCamposQuery
				call BD.insereCampoQuery ("COD_USUARIOGED",session("login").item("COD_USUARIOGED"))
				call BD.abreQuery ("LOGSEQUENCIAL",1)
				if session("login").exists("SQ_LOGINUSUARIOGED") then call session("login").remove("SQ_LOGINUSUARIOGED")
				call session ("login").add("SQ_LOGINUSUARIOGED",BD.valor ("SQ_LOGINUSUARIOGED"))

				call BD.fechaQuery

			case "I"
				if primConsImg then
					'Não há consultas a imagens. Crie a primeira
					call BD.insereCampoQuery ("SEQ","1")
				else
					'Já há consultas a imagens. Crie a próxima
					call BD.insereCampoQuery ("SEQ","(SELECT MAX(SQ_CONSULTAIMAGEM) FROM CONSULTAIMAGEM)+1")
				end if

				'Insere o log
				call BD.insereCampoQuery("SEQUENCIAL",info)
				call BD.abreQuery ("LOGCONSIMG",0)

				'Retorna o valor de SQ_CONSULTAIMAGEM
				call BD.limpaCamposQuery
				call BD.insereCampoQuery ("COD_USUARIOGED",session("login").item("COD_USUARIOGED"))
				call BD.abreQuery ("LOGCONSIMGRET",1)
				logaAtividade = "IMG_" & BD.valor ("SQ_CONSULTAIMAGEM") & _
								"_" & session("login").item("COD_USUARIOGED") & ".TIF"
				call BD.fechaQuery

			case "N"
				if primConsNire then
					'Não há consultas a imagens. Crie a primeira
					call BD.insereCampoQuery ("SEQ","1")
				else
					'Já há consultas a imagens. Crie a próxima
					call BD.insereCampoQuery ("SEQ","(SELECT MAX(SQ_CONSULTANIRE) FROM CONSULTANIRE)+1")
				end if

				'Insere o log
				call BD.insereCampoQuery("NR_NIRE",info)
				call BD.abreQuery ("LOGCONSNIRE",0)

			case "A"
				if primConsAut then
					'Não há consultas de autenticidade. Crie a primeira
					call BD.insereCampoQuery ("SEQ","1")
				else
					'Já há consultas de autenticidade. Crie a próxima
					cal BD.insereCampoQuery ("SEQ","(SELECT MAX(SQ_CONSULTAAUTENTICIDADE) FROM CONSULTAAUTENTICIDADE)+1")
				end if

				'Insere o log
				call BD.insereCampoQuery("CONTROLE",split(info,",")(0))
				call BD.insereCampoQuery("EMAIL",split(info,",")(1))
				call BD.abreQuery ("LOGCONSAUT",0)

		end select
		if BD.erro <> msgOk then response.write ("<b>Erro!</b><br />" & BD.erro & "<br /><br />")

		call BD.desconecta

	end function


	function textoTermosUso

		dim Arq
		dim sLinhas

		Set Arq = FSO.OpenTextFile (Application ("stCamDados") & "modelos\txtTermosUso.txt",1,false)
		sLinhas = Arq.ReadAll
		Arq.Close

		textoTermosUso = sLinhas

	end function
%>