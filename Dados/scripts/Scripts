CREATE TABLE DEFAULT_ACESSO.CARDS_USUARIO (
	ID NUMBER PRIMARY KEY,    
	MATRICULA VARCHAR2(15) NOT NULL,
	NOME VARCHAR2(200),
    EMAIL VARCHAR2(200),
    SENHA VARCHAR2(1000),
    ATIVO CHAR(1),
    TIPO CHAR(1),
    DT_CADASTRO DATE,
    IP VARCHAR2(20),
    ID_LIBERACAO NUMBER,
    DT_LIBERACAO DATE,
    CONSTRAINT fk_cards_usuario_id FOREIGN KEY (ID_LIBERACAO) REFERENCES DEFAULT_ACESSO.CARDS_USUARIO(ID),
    CONSTRAINT unique_usuario_cpf UNIQUE (MATRICULA,EMAIL)
);

