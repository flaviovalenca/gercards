CREATE TABLE DEFAULT_ACESSO.CARDS (
	ID NUMBER PRIMARY KEY,
    ID_EMPRESA_NAVIO NUMBER,
    NUMERO_CONTRATO VARCHAR2(10),
    NOME_REQUISITANTE VARCHAR2(50),
    ID_CARDS VARCHAR2(8	0),
    TIPO_OUTRO VARCHAR2(100),  
    DESCRICAO VARCHAR2(4000),
    DATA_SOLICITACAO DATE,
    DATA_INICIO DATE,
    DATA_TERMINO DATE,
    QUANTIDADE NUMBER,
    ID_UNIDADE NUMBER,
    UNIDADE_OUTRO VARCHAR2(100),
    NOME_ASSINANTE VARCHAR2(100),
    EMAIL_ASSINANTE VARCHAR2(200),
    ENVELOPE_ID VARCHAR(2000),
    DATA_ASSINATURA DATE,
    ID_CARDS_TIPO_ID_DET_ID NUMBER
    CONSTRAINT fk_cards_empresa_navio_id FOREIGN KEY (ID_EMPRESA_NAVIO) REFERENCES DEFAULT_ACESSO.CARDS_EMPRESA_NAVIO(ID),
    CONSTRAINT fk_cards_tp_id_tp_det_id_fk FOREIGN KEY (ID_CARDS_TIPO_ID_DET_ID) REFERENCES DEFAULT_ACESSO.CARDS_TIPO_ID_TIPO_DETALHE_ID(ID),
    CONSTRAINT fk_cards_unidade_id FOREIGN KEY (ID_UNIDADE) REFERENCES DEFAULT_ACESSO.CARDS_UNIDADE(ID)
);


