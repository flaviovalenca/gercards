
SELECT 	
  saee.*,sae.*
 FROM 	DAEJucepe DJ LEFT JOIN
	 (PESSOA_JURIDICA PJ INNER JOIN PESSOA P ON PJ.SQ_PESSOA = P.SQ_PESSOA) ON DJ.NR_NIRE = PJ.NR_NIRE 
	 LEFT JOIN 	SOLICITACAOATOEVENTO SAE ON DJ.PROTOCOLO = SAE.PROTOCOLO 
	LEFT JOIN SOLICITACAOATOEVENTOESPECIFICA SAEE ON SAE.SOLICITACAOATOEVENTO = SAEE.SOLICITACAOATOEVENTO WHERE 	DJ.Protocolo = '110001052' 


SELECT * FROM PESSOA_FISICA WHERE ROWNUM < 20

SELECT P.*
 FROM VINCULO V INNER JOIN PESSOA P
ON V.SQ_PESSOA_VINCULANTE = P.SQ_PESSOA INNER JOIN PESSOA_JURIDICA PJ ON 
  V.SQ_PESSOA_VINCULANTE = PJ.SQ_PESSOA LEFT JOIN PESSOA_FISICA PF ON 
  V.SQ_PESSOA_VINCULADA = PF.SQ_PESSOA LEFT JOIN PESSOA P1 ON P1.SQ_PESSOA = PF.SQ_PESSOA LEFT JOIN
  MUNICIPIO M ON M.CO_MUNICIPIO = P.CO_MUNICIPIO LEFT JOIN SITUACAO S ON PJ.CO_SITUACAO = S.CO_SITUACAO LEFT JOIN
  CONDICAO C ON V.CO_CONDICAO = C.CO_CONDICAO
 WHERE (C.IN_TIPO_TABELA = '1') AND PF.NR_CPF = '66774977472' 
 ORDER BY
	P.NO_PESSOA
	
	

 SELECT * FROM PESSOA WHERE NO_PESSOA LIKE '%ALBERTO JORGE CAJUEIRO DE ARAGAO ME%';
 SELECT * FROM PESSOA_FISICA WHERE NR_CPF = '02220237400';
 SELECT * FROM VINCULO WHERE SQ_PESSOA_VINCULADA = 605478;
 SELECT * FROM CONDICAO ORDER BY CO_CONDICAO;

 SELECT 
    PF.NR_CPF,P.NO_PESSOA,V.CO_CONDICAO, S.DS_SITUACAO
 FROM 
    VINCULO V LEFT JOIN PESSOA_FISICA PF ON V.SQ_PESSOA_VINCULADA = PF.SQ_PESSOA LEFT JOIN PESSOA P ON 
    V.SQ_PESSOA_VINCULANTE = P.SQ_PESSOA LEFT JOIN PESSOA_JURIDICA PJ ON V.SQ_PESSOA_VINCULANTE = PJ.SQ_PESSOA 
    LEFT JOIN SITUACAO S ON PJ.CO_SITUACAO = S.CO_SITUACAO
 WHERE  
    ROWNUM <=10 AND NR_CPF IS NOT NULL AND S.CO_SITUACAO IN ('00')
    
     
     ('00','03','02','13','04','06','07','08','09','10','11','12','14','15','16','17','18')
    
SELECT * FROM SITUACAO


 SELECT 
    PJ.SQ_PESSOA SQ_PESSOA_EMPRESA,V.SQ_PESSOA_VINCULADA SQ_PESSOA_EMPRESARIO,FI.SQ_PESSOA SQ_PESSOA_FISICA_INDIVIDUAL, PF.NR_CPF,P.NO_PESSOA,V.CO_CONDICAO, S.DS_SITUACAO
 FROM 
    VINCULO V LEFT JOIN PESSOA_FISICA PF ON V.SQ_PESSOA_VINCULADA = PF.SQ_PESSOA LEFT JOIN PESSOA P ON 
    V.SQ_PESSOA_VINCULANTE = P.SQ_PESSOA LEFT JOIN PESSOA_JURIDICA PJ ON V.SQ_PESSOA_VINCULANTE = PJ.SQ_PESSOA 
    LEFT JOIN SITUACAO S ON PJ.CO_SITUACAO = S.CO_SITUACAO LEFT JOIN FISICA_INDIVIDUAL FI ON V.SQ_PESSOA_VINCULADA = FI.SQ_PESSOA
 WHERE  
     PF.NR_CPF = '02229579487' AND V.CO_CONDICAO = '801'

    