	' Parâmetros - protocolo - protocolo que deseja consultar
	' =======================================================
   Function fnFormataDocumento(documento)
		Dim result
		result = documento
		If fnIdCpfCnpj(documento) = "CPF" Then result = fnFormataCPF(documento)
		If fnIdCpfCnpj(documento) = "CNPJ" Then result = fnFormataCNPJ(documento)
		fnFormataDocumento = result
   End Function

    ' =======================================================
	' 17/05/2011 - Verifica se a certidão foi gerada ou 
	'              marcada as páginas a serem exibidas
	' Função     - CertidaoFoiGerada             
	' Autor      - Flávio Valença
	' Parâmetros - protocolo - protocolo que deseja consultar
	' =======================================================
   Function CertidaoFoiGerada
		Dim BD
		Set BD = new TBD

		Dim result
		Dim valorpago

		'Resgata a flag de geração
		call BD.conecta

		result = false
			
		' =====================================================
		' Verifica se a Certidão Simplificada - 611 foi gerada
		' =====================================================
		if (session("DAE").item("codAto") = "611") Then
			call BD.limpacamposquery
			call BD.insereCampoQuery ("PROTOCOLO",session("DAE").item("nrProtocolo"))
			call BD.abreQuery ("CERTIDAO_POR_PROTOCOLO",1)

			If Not (BD.EOF) Then
				If (BD.valor("FLAGGERADO") = "S") Then
					result = True
				End If
			End If			
			Call BD.fechaquery
		End If

		' ==============================================================
		' Verifica se foram marcadas as páginas a serem entregues e se
		' as páginas marcadas existem no documento.
		' Vale para Certidão de Inteiro Teor Internet e outros documentos
		' ===============================================================
		if ((session("DAE").item("codAto") <> "611") and  (session("DAE").item("codAto") <> "612")) Then ' Se não for simplificada 	
			call BD.limpacamposquery
			call BD.limpacamposquery
			call BD.insereCampoQuery ("PROTOCOLO",session("DAE").item("ProtocoloArquivadoSolicitado"))
			call BD.abreQuery ("IMAGEM",1)

			Dim arrayPaginas, ArrayDePaginaInformadoCorretamente, Pag
			
			If Not(BD.EOF) Then
				If Trim(BD.valor("PAGEXIBIR")) <> "" Then
						arrayPaginas = Split(Replace(BD.valor("PAGEXIBIR"),",",";"),";")
						ArrayDePaginaInformadoCorretamente = false
						for i = 0 to ubound (arrayPaginas)	
						    Pag = CInt(arrayPaginas(i))
							If (Pag >= 1 And Pag <= CInt(BD.valor("PAGINAS"))) Then
								ArrayDePaginaInformadoCorretamente = True
							End If
						Next
					If ArrayDePaginaInformadoCorretamente Then
						result = True
					End If
				End If
			End If

			Call BD.fechaquery

		End If

		' ===========================================================
		' Verifica se a Certidão Específica Internet - 612 foi gerada
		' ===========================================================
		if (session("DAE").item("codAto") = "612") Then
			
			' Lembrar de remover
			'Call BD.conectaDireto("dbjpe01_jucsrvdb02", "dbjpe01", "daegeddbe", "eq3533", "ORACLE")
			Call BD.conectaDireto("dbjpe01", "dbjpe01", "daegeddbe", "eq3533", "ORACLE")
			call BD.limpacamposquery
			call BD.insereCampoQuery ("NR_PROTOCOLO",session("DAE").item("nrProtocolo"))
			call BD.abreQuery ("SOLICITACAOCERTIDAOESPECIFICA",1)

			If Not (BD.EOF) Then
				' Para os tipos de certidão 1 e 2 a geração é automática. 
				' Logo não precisa de resposta do apertador de pitoco
			    If (BD.valor("TIPOCERTIDAO") = "1") Or (BD.valor("TIPOCERTIDAO") = "2") Then
				    result = True
	                ' Nos demais casos precisa da resposta
				ElseIf (BD.valor("RESPOSTA") <> "NULL")  Then
					result = True
				End If
			Else
				result = False
			End IF

			Call BD.fechaquery
		End If
	
		
		
		'Fecha a query
		call BD.desconecta
		set BD = Nothing

		CertidaoFoiGerada = result

	End Function


	'Data 18/05/2011
	'Autor     - Leandro
	'Alteração - Flávio Valença	em 18/05/2011  
	'Função:
	'	- reqImgFS
	'
	'Descrição:
	'	- Solicita, através do FileSystem, uma imagem
	'	  A imagem será salva na pasta temporária e o caminho
	'	  completo para a mesma irá retornar como valor da
	'	  função (caso não haja erro)
	'
	'Requisitos:
	'	- db
	'	- adoConst
	'	- fnGerais
	'
	'Parâmetros:
	'	- us:			Código do usuário (number)
	'	- pr:			Número do protocolo (string[9])
	'	- tout:			Tempo de espera pelo servidor (ms)
	'	- arq:			Nome esperado do arquivo
	'
	'Retorno:
	'	- Nome do arquivo OU
	'	- Código de erro
	'		2: Timeout (servidor não respondeu)
	'		3: Protocolo não encontrado
	'		4: Imagem não encontrada
	'		5: Erro não especificado
	function reqImgFS(pr,tout,arq)
		dim arquivo, nomeArq, nomeArqImg
		dim timeInic, timeAtual, s
		Dim textoCarimbo
		Dim flgCarimbar
		Dim direitos
		Dim restoMensagem

		dim FSO,BD
		set BD = New TBD

		'Obtém o nome completo do arquivo a partir do protocolo
		call BD.conecta
		call BD.insereCampoQuery ("PROTOCOLO",pr)
		call BD.abreQuery ("CAMINHOIMAGEM_PROTOCOLO",1)
		if BD.EOF then
			reqImgFS = 3
			call BD.desconecta
			set BD = nothing
			exit function
		end if
		nomeArqImg = BD.valor ("CAMINHO")
		call BD.fechaQuery

		'Verifica se este arquivo existe aqui (alguma solicitação nas últimas 24h)
		set FSO = CreateObject("Scripting.FileSystemObject")
		s = Session ("stCamWeb") & "temp\" & nomeArqImg

		If Not FSO.fileExists(s) then

			'Cria um arquivo-texto com o path + nome do arquivo a ser solicitado
			nomeArq = Session ("stCamWeb") & "temp\" & "TEOR" & fnFormataData(date,12) & fnFormataHora(time,6) & fnNomeRand (5) & ".tmp"
'			response.write nomeArq
'			response.end
			set arquivo = FSO.OpenTextFile (nomeArq,2,true)
			arquivo.WriteLine(nomeArqImg)
			arquivo.close
			call FSO.moveFile (nomeArq,Replace(nomeArq,".tmp",".req"))
			set arquivo = nothing

			'Entra em loop (por 'tout' ms) esperando o arquivo com o nome especificado (arq)
			timeInic = cdbl(timer)
			s = ""
			do
				timeAtual = cdbl(timer)
				s = Session ("stCamWeb") & "temp\" & fnGetFileName(nomeArqImg)

				If Not FSO.fileExists(s) Then s = ""


			loop until	(timeAtual > timeInic + tout/1000) Or (s <> "")

		End If

		'Se houve timeout, retorna erro
		If s = "" Then 
			reqImgFS = 2
			Exit function
		End If
		
		'Retorna o nome da imagem como resultado da função
		reqImgFs = arq

	End Function

    ' =======================================================
	' 17/05/2011 - Verifica se o processo foi arquivado
	' Função     - ProcessoArquivado            
	' Autor      - Flávio Valença
	' Parâmetros - protocolo - protocolo que deseja consultar
	' =======================================================
   Function ProcessoArquivado(protocolo)
		Dim BD
		Set BD = new TBD

		Dim result
		Dim valorpago

		result = false

		'Resgata a flag de geração
		call BD.conecta
		call BD.insereCampoQuery ("PROTOCOLO",protocolo)
		call BD.abreQuery ("PROCESSOARQUIVADO",1)

		If (BD.EOF) Then
			result = False
		ElseIf (IsEmpty(BD.valor("NR_NIRE"))) Then
		  	result = False
		ElseIf (Trim(BD.valor("NR_NIRE")) = "") Then
			result = False
		Else
		    result = True
		End If			
	
		'Fecha a query
		call BD.desconecta
		set BD = Nothing
		
		ProcessoArquivado = result

	End Function

    ' =======================================================
	' 17/05/2011 - Verifica se o processo foi digitalizado
	' Função     - ProcessoDigitalizado             
	' Autor      - Flávio Valença
	' Parâmetros - protocolo - protocolo que deseja consultar
	' =======================================================
   Function ProcessoDigitalizado(protocolo)
		Dim BD
		Set BD = new TBD

		Dim result

		result = false

		'Resgata a flag de geração
		call BD.conecta
		call BD.insereCampoQuery ("PROTOCOLO",protocolo)
