		If (BD.EOF) Then
			result = False
		ElseIf (IsEmpty(BD.valor("NR_PROTOCOLO"))) Then
		  	result = False
		ElseIf (Trim(BD.valor("NR_PROTOCOLO")) = "") Then
			result = False
		Else
		    result = True
		End If			
	
		'Fecha a query
		call BD.desconecta
		set BD = Nothing
		
		ProcessoDigitalizado = result

	End Function

    ' =======================================================
	' 31/05/2011 - Verifica se o documento pode ser arquivado
	'              ou seja, o documento será digitalizado e 
	'              entregue ao cliente
	' Função     - PodeSerArquivado             
	' Autor      - Flávio Valença
	' Parâmetros - protocolo - protocolo que deseja consultar
	' =======================================================
	Function PodeSerArquivado(Ato)
		Dim Atos, Pode
		Pode = False
	    Atos = array("001","002","003","004","005","006","007","008","009","010","012","013","014","015","016","017","018","019","020","021","022","048","080","082","090","101","150",	"151","152","201","202","203","205","206","207","208","209","210","212","213","214","215","217","218","225","227","234","301","302","303","304","305","306","307","308","309","310","311","315","316","317","318","402","409","417","418","501","502","600","601","701","710","808","901","902","903","904","980","981","983","984","A01","A02","A03","A04","A05","B02","B03","B04","B05","B06","B07","B08","B09","B10","B11","B12","B13","B14","B15","B16","B17","B18","B20","B21","B25","B27","B29","B30","B31","D05","D06","D09","E10","E11","F00","F01","F07","J98") 
		For i = 0 to ubound(Atos)
			If Ato = Atos(i) Then
				Pode = True
			End IF
		Next	
		PodeSerArquivado = Pode
	End Function


    ' =======================================================
	' 31/05/2011 - Grava log de atividades
	' Função     - gravaLog             
	' Autor      - Leandro
	' Parâmetros - secao - 
	' =======================================================	
	function gravaLog (secao, texto, nivel)
		dim f, ip


		gravaLog = (nivel <= nivelLog)
		if nivel <= nivelLog then

			ip = right("               " & request.serverVariables("REMOTE_ADDR"),15)

			set f = FSO.openTextFile(session("stCamDados") & "logs\" & fnFormataData(CDate(date+time),12) & ".log", 8, true)
			f.WriteLine(fnFormataData (date,14) & " " & fnFormataHora(CDate(date+time),1) & " " & ip & " (" & secao & ") - " & texto)
			f.close

		end if

	end Function
	

	' =======================================================
	' 18/10/2011 - Tipo de Certidão Específica
	' Função     - tipocertidaoespecifica             
	' Autor      - Flávio Valença
	' Parâmetros - Código da Certidão - 
	' =======================================================	
	Function tipocertidaoespecifica (codigo)

		Dim retorno
		
		Select Case codigo

			Case "1"
				retorno = "De Participação de Pessoa Física em sociedade(exceto S.A e Coop.) "
			Case "2"
				retorno = "De Participação de Pessoa Jurídica em sociedade(exceto S.A e Coop.) "
			Case "3"
				retorno = "Nada Consta Pessoa Física "
			Case "4"
				retorno = "Nada Consta Pessoa Jurídica "
			Case "5"
				retorno = "A Definir "
			Case "6"
				retorno = "Existência de Empresa (com endereço) "
			Case Else
				retorno = ""		

		End Select 
		
		tipocertidaoespecifica = retorno

	End Function

    ' =======================================================
	' 25/11/2011 - Resgata o nome da empresa
	' Função     - ResgataNomeEmpresa             
	' Autor      - Flávio Valença
	' Parâmetros - protocolo - protocolo que deseja consultar
	'              o nome da empresa
	' =======================================================
   Function fnResgataNomeEmpresa(protocolo)
		Dim BD
		Set BD = new TBD

		Dim result

		result = ""

		'Resgata a flag de geração
		call BD.conecta
		call BD.insereCampoQuery ("NR_PROTOCOLO",protocolo)
		call BD.abreQuery ("NOMEEMPRESAPORPROTOCOLO",1)

		If Not BD.EOF Then			
		    result = BD.valor("NO_EMPRESARIAL")
		End If			
	
		'Fecha a query
		call BD.desconecta
		set BD = Nothing
		
		fnResgataNomeEmpresa = result

	End Function

	Function solicitacaoInterna

		Dim BD
		Set BD = new TBD

		'Detecta se o documento está sendo gerada na JUCEPE
		call BD.conecta
		'Se foi um forward, a indicação é aqui
		if Trim(request.servervariables("HTTP_X_FORWARDED_FOR")) & "" <> "" then
			call BD.insereCampoQuery ("IP",request.servervariables("HTTP_X_FORWARDED_FOR"))
		else
			call BD.insereCampoQuery ("IP",request.servervariables("REMOTE_ADDR"))
		end If

		call BD.abreQuery ("IPJUCEPE",1)

		solicitacaoInterna = not BD.EOF

		call BD.desconecta
		set BD = nothing

	end function
	

%>